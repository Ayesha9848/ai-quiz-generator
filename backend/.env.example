# DB
# Local SQLite (dev)
# DATABASE_URL=sqlite:///./quiz_history.db

# Production/Postgres example:
DATABASE_URL=postgresql+psycopg2://quizuser:quizpass@db:5432/quizdb

# Gemini API (optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5

# Allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
